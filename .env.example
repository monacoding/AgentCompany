# AgentCompany LLM Configuration
# ChatGPT / OpenAI API Key (둘 중 하나만 설정해도 됩니다)
CHATGPT_API_KEY=sk-your-openai-api-key-here
OPENAI_API_KEY=

# Optional — 이번 달 API 사용액 조회용 (잔액/크레딧은 API 미제공, 대시보드에서 확인)
# platform.openai.com → Settings → Admin keys
# OPENAI_ADMIN_KEY=sk-admin-...

# Optional
# DEFAULT_MODEL=gpt-4o
# DEFAULT_PROVIDER=openai

# Crawl4AI Docker (원영 Research Agent — Activate 시 자동 실행)
# CRAWL4AI_BASE_URL=http://localhost:11235
# agentCompany.crawl4aiAutoStart=true
